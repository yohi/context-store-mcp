# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_store
POSTGRES_USER=context_store_user
POSTGRES_PASSWORD=changeme

# PostgreSQL Test Configuration
# Tests default to context_store_test to avoid accidentally targeting production
# Override POSTGRES_DB in your test environment if needed

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_MAX_MEMORY=256mb

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=info

# Lite Mode Configuration
# Enable Lite mode (PostgreSQL only, no Neo4j or Redis required)
LITE_MODE=false

# Optional: Explicitly control individual components
# ENABLE_GRAPH_STORE=true
# ENABLE_REDIS_CACHE=true

# Embedding Provider Configuration
# Options: openai (default), local-cli, custom-api
EMBEDDING_PROVIDER=openai

# For local-cli provider: specify the CLI command to generate embeddings
# Example: gemini-cli embed, claude-code embed, cursor-cli embed
# EMBEDDING_CLI_COMMAND=gemini-cli embed

# For custom-api provider: specify the API endpoint
# EMBEDDING_API_ENDPOINT=http://localhost:8080/embeddings
