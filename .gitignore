# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Docker volumes (persistent data should not be committed)
docker/volumes/

# Backup files (narrow exclusion to backup directories only)
# Allow legitimate SQL/dump files in repository (migrations, init scripts)
!docker/init-scripts/**/*.sql
!migrations/**/*.sql
backup.*
**/backups/**/*.sql
**/backups/**/*.dump
**/dumps/**/*.sql
**/dumps/**/*.dump
