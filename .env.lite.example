# ============================================
# Context Store MCP - Lite Mode Configuration
# ============================================
# This configuration enables Lite Mode, which runs with PostgreSQL only,
# without Neo4j (graph store) or Redis (cache).
# Ideal for personal use on resource-constrained machines.

# ============================================
# Lite Mode Settings
# ============================================
# Enable Lite mode (PostgreSQL only, no Neo4j or Redis required)
LITE_MODE=true

# Explicitly disable optional components
ENABLE_GRAPH_STORE=false
ENABLE_REDIS_CACHE=false

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_store
POSTGRES_USER=context_store_user
POSTGRES_PASSWORD=changeme

# ============================================
# Embedding Provider Configuration
# ============================================
# Options: openai (default), local-cli, custom-api
# 
# For OpenAI (requires API key):
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# For local CLI tools (no API key required):
# Uncomment and configure one of the following:
# EMBEDDING_PROVIDER=local-cli
# EMBEDDING_CLI_COMMAND=gemini-cli embed
# EMBEDDING_CLI_COMMAND=claude-code embed
# EMBEDDING_CLI_COMMAND=cursor-cli embed
# EMBEDDING_CLI_COMMAND=codex-cli embed

# For custom API endpoint:
# EMBEDDING_PROVIDER=custom-api
# EMBEDDING_API_ENDPOINT=http://localhost:8080/embeddings

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Optional: Collector Configuration
# ============================================
# If you're using collectors to automatically gather conversation data
# from AI Desktop Apps, AI IDEs, or CLI agents, configure them here.

# Desktop App Collectors (Claude Desktop, ChatGPT Desktop, etc.)
# COLLECTOR_CLAUDE_DESKTOP_LOG_PATH=~/.config/Claude/logs/conversations.log
# COLLECTOR_CHATGPT_DESKTOP_LOG_PATH=~/.config/ChatGPT/logs/conversations.log

# AI IDE Collectors (Cursor, Windsurf, Copilot, Cline, etc.)
# COLLECTOR_CURSOR_LOG_PATH=~/.cursor/logs/conversations.log
# COLLECTOR_WINDSURF_LOG_PATH=~/.windsurf/logs/conversations.log
# COLLECTOR_COPILOT_LOG_PATH=~/.vscode/extensions/github.copilot/logs/conversations.log
# COLLECTOR_CLINE_LOG_PATH=~/.cline/logs/conversations.log

# CLI Agent Collectors (ClaudeCode, GeminiCLI, CodexCLI, CursorCLI, etc.)
# COLLECTOR_CLAUDE_CODE_LOG_PATH=~/.claude-code/logs/conversations.log
# COLLECTOR_GEMINI_CLI_LOG_PATH=~/.gemini-cli/logs/conversations.log
# COLLECTOR_CODEX_CLI_LOG_PATH=~/.codex-cli/logs/conversations.log
# COLLECTOR_CURSOR_CLI_LOG_PATH=~/.cursor-cli/logs/conversations.log

# Collector polling interval (in milliseconds)
# COLLECTOR_POLL_INTERVAL=1000

# ============================================
# Optional: Web Viewer Configuration
# ============================================
# Enable the web-based memory viewer (optional)
# WEB_VIEWER_ENABLED=false
# WEB_VIEWER_PORT=3001
# WEB_VIEWER_AUTH_ENABLED=true
# WEB_VIEWER_AUTH_TOKEN=your_secure_token_here

# ============================================
# Docker Compose Profile
# ============================================
# When using Docker Compose, use the 'lite' profile:
# docker compose --profile lite up -d
#
# This will start only PostgreSQL, not Neo4j or Redis.

# ============================================
# Notes
# ============================================
# - Lite Mode uses in-memory caching instead of Redis
# - Graph relationships are stored as JSONB in PostgreSQL
# - Memory usage: < 500MB idle (vs ~2GB for full mode)
# - All core features work, but without graph traversal capabilities
# - To switch to full mode, set LITE_MODE=false and use --profile full
