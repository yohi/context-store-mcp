# Lite Mode Configuration Example
# This configuration runs Context Store MCP with minimal infrastructure requirements
# Only PostgreSQL is required - no Neo4j or Redis needed

# Enable Lite Mode
LITE_MODE=true

# PostgreSQL Configuration (Required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_store
POSTGRES_USER=context_store_user
POSTGRES_PASSWORD=changeme

# Embedding Provider Configuration
# Options: openai (default), local-cli, custom-api
EMBEDDING_PROVIDER=openai

# OpenAI API (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here

# For local-cli provider: specify the CLI command to generate embeddings
# Example: gemini-cli embed, claude-code embed, cursor-cli embed
# EMBEDDING_PROVIDER=local-cli
# EMBEDDING_CLI_COMMAND=gemini-cli embed

# For custom-api provider: specify the API endpoint
# EMBEDDING_PROVIDER=custom-api
# EMBEDDING_API_ENDPOINT=http://localhost:8080/embeddings

# Logging
LOG_LEVEL=info

# Optional: Explicitly control individual components (not needed in Lite mode)
# ENABLE_GRAPH_STORE=false
# ENABLE_REDIS_CACHE=false
