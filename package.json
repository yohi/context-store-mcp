{
  "name": "context-store-mcp",
  "version": "0.1.0",
  "description": "AIエージェント向けMCPベース長期記憶システム - セッションを越えて情報を永続保存し、文脈に応じた検索を可能にする",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "test:integration": "cp .env.test.example .env.test 2>/dev/null || true && docker-compose -f docker-compose.test.yml up -d && sleep 15 && vitest run --config vitest.integration.config.ts && docker-compose -f docker-compose.test.yml down",
    "test:integration:watch": "docker-compose -f docker-compose.test.yml up -d && vitest --config vitest.integration.config.ts",
    "test:integration:setup": "docker-compose -f docker-compose.test.yml up -d",
    "test:integration:teardown": "docker-compose -f docker-compose.test.yml down -v",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t context-store-mcp:latest .",
    "docker:run": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "deploy": "./scripts/deploy.sh",
    "benchmark": "tsx scripts/benchmark.ts",
    "health-check": "tsx scripts/health-check.ts",
    "validate-config": "tsx scripts/validate-configuration.ts",
    "security-audit": "npm audit --production --audit-level=high"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai-agent",
    "vector-search",
    "graph-database",
    "long-term-memory"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^2.1.8",
    "shell-quote": "^1.8.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.6",
    "neo4j-driver": "^5.27.1",
    "openai": "^6.5.0",
    "pg": "^8.14.0",
    "pgvector": "^0.2.1",
    "redis": "^4.7.0",
    "winston": "^3.18.3",
    "zod": "^3.24.1"
  }
}
