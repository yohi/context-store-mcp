# ============================================
# Context Store MCP - ローカル本番環境設定
# ============================================
# このファイルはローカルマシンで本番サーバーを運用するための設定です
# 
# セキュリティ重要事項:
# - このファイルをバージョン管理システムにコミットしないでください
# - 強固なパスワードを使用してください（openssl rand -base64 32）
# - 定期的にパスワードを変更してください

# ============================================
# PostgreSQL Configuration
# ============================================
# PostgreSQL 16 + pgvector による構造化データとベクトル検索

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_store
POSTGRES_USER=context_store_user
# 強固なパスワードに変更してください（例: openssl rand -base64 32）
POSTGRES_PASSWORD=REPLACE_ME_REQUIRED

# ============================================
# Neo4j Configuration
# ============================================
# Neo4j 5.x によるグラフデータベース（記憶間の関係性管理）

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 強固なパスワードに変更してください（例: openssl rand -base64 32）
NEO4J_PASSWORD=REPLACE_ME_REQUIRED

# Neo4j ポート設定
NEO4J_HTTP_PORT=7474  # Web UI用
NEO4J_BOLT_PORT=7687  # クライアント接続用

# Neo4j メモリ設定（ローカルマシンのスペックに応じて調整）
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# ============================================
# Redis Configuration
# ============================================
# Redis 7.x によるキャッシング

REDIS_HOST=localhost
REDIS_PORT=6379
# 強固なパスワードに変更してください（例: openssl rand -base64 32）
REDIS_PASSWORD=REPLACE_ME_REQUIRED

# Redis メモリ設定
REDIS_MAX_MEMORY=256mb

# ============================================
# OpenAI API Configuration
# ============================================
# 記憶の分類とベクトル化に使用
# https://platform.openai.com/api-keys から取得

OPENAI_API_KEY=sk-your-api-key-here

# 使用するモデル（オプション）
# OPENAI_MODEL=gpt-4
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Security Configuration
# ============================================
# 監査ログの署名用シークレット
# 強固なシークレットに変更してください（例: openssl rand -base64 32）
SIGNATURE_SECRET=REPLACE_ME_REQUIRED

# ============================================
# Logging Configuration
# ============================================
# ログレベル: error, warn, info, debug
# 本番環境では info を推奨
LOG_LEVEL=info

# ログファイルの保存先（オプション）
# LOG_FILE=logs/context-store-mcp.log

# ============================================
# Application Configuration
# ============================================
# アプリケーションポート（通常は変更不要）
# PORT=3000

# Node.js 環境
NODE_ENV=production

# ============================================
# Performance Tuning (オプション)
# ============================================
# Node.js メモリ制限（MB単位）
# NODE_OPTIONS=--max-old-space-size=4096

# データベース接続プール設定
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ============================================
# Backup Configuration (オプション)
# ============================================
# バックアップの保存先
# BACKUP_DIR=./backups

# バックアップの保持期間（日数）
# BACKUP_RETENTION_DAYS=30

# ============================================
# セットアップ手順
# ============================================
# 推奨: 自動セットアップスクリプトを使用
# このスクリプトは強固なパスワードを自動生成し、安全に設定します
#
#    ./scripts/setup-production.sh
#
# 手動セットアップ（上級者向け）:
# 1. このファイルをコピー:
#    cp .env.production.local.example .env.production.local
#
# 2. 強固なパスワードを生成:
#    openssl rand -base64 32
#
# 3. 上記のパスワードで以下を置き換え:
#    - POSTGRES_PASSWORD
#    - NEO4J_PASSWORD
#    - REDIS_PASSWORD
#    - SIGNATURE_SECRET
#
# 4. OpenAI API Keyを設定:
#    - https://platform.openai.com/api-keys から取得
#    - OPENAI_API_KEY に設定
#
# 5. 必要に応じてメモリ設定を調整
#
# 6. サーバーを起動:
#    ./scripts/start-production.sh
#
# 注意: REPLACE_ME_REQUIRED のままでは起動時にエラーになります

