# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# Application
NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info

# PostgreSQL Configuration (Production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=context_store
POSTGRES_USER=context_store_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Neo4j Configuration (Production)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Redis Configuration (Production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
REDIS_MAX_MEMORY=512mb

# OpenAI API
OPENAI_API_KEY=sk-CHANGE_ME_YOUR_OPENAI_API_KEY_HERE

# Security
# Generate with: openssl rand -base64 32
SIGNATURE_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_HERE

# Monitoring (Optional)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Backup (Optional)
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
